; cellhack2 NASM constants.  GENERATED by engine/tools/gen_inc.py from
; engine/include/cellhack/view.h and rules.h.  Do not edit by hand.
;
; The server prepends this file to your source automatically; you never need
; to %include it.  It is published so you can read the names and values.

; ---- ABI
ABI_VERSION       equ 4           ; bumped when anything in this file changes incompatibly

; ---- Guest memory map (identical for every colony)
CODE_BASE         equ 0x00100000  ; your program, entry at offset 0, read+exec
CODE_SIZE         equ 0x00010000  ; 64 KB region; your blob may be at most CODE_MAX bytes
CODE_MAX          equ 0x00008000  ; 32 KB maximum program size
STACK_BASE        equ 0x00200000  ; read+write, zeroed before every call
STACK_SIZE        equ 0x00004000  ; 16 KB; guard pages on both sides are unmapped
STACK_TOP         equ 0x00204000  ; rsp starts at STACK_TOP-8 (return address pushed)
VIEW_BASE         equ 0x00300000  ; read-only view struct, also passed in rdi
VIEW_SIZE         equ 0x00001000  ; 4 KB mapped (struct is VIEW_STRUCT_SIZE bytes)
CELLMEM_BASE      equ 0x00310000  ; read+write scratch, also passed in rdx
CELLMEM_SIZE      equ 0x00001000  ; 4 KB; only the first MEM_SIZE bytes persist
EXIT_ADDR         equ 0x00400000  ; return address; `ret` lands here and ends the call

; ---- View struct, pointer in rdi
VIEW_STRUCT_SIZE  equ 128         ; total bytes; unused bytes are zero
VIEW_TICK         equ 0           ; u32  current tick (0-based)
VIEW_ENERGY       equ 4           ; u8   your energy (same value as rsi)
VIEW_RAND         equ 6           ; u8   a fresh random byte for this call
VIEW_AGE          equ 7           ; u8   ticks since you were born, saturates at 255
VIEW_X            equ 8           ; u16  your x position (0 = left)
VIEW_Y            equ 10          ; u16  your y position (0 = top)
VIEW_W            equ 12          ; u16  arena width
VIEW_H            equ 14          ; u16  arena height
VIEW_POP_SELF     equ 16          ; u16  living cells in your colony
VIEW_POP_ENEMY    equ 18          ; u16  living cells in all other colonies
VIEW_COLONY       equ 20          ; u8   your colony slot (0..3)
VIEW_CELLS        equ 32          ; u8[25] 5x5 neighbourhood, row-major, see VIEW_IDX
VIEW_ENERGIES     equ 64          ; u8[25] energy of each neighbour (0 for empty/wall): byte [rdi + VIEW_ENERGIES + index]
VIEW_RADIUS       equ 2           ; neighbourhood radius: cells within +-2 are visible
VIEW_DIM          equ 5           ; neighbourhood is VIEW_DIM x VIEW_DIM
VIEW_CENTER       equ 12          ; index of yourself: (2+2)*5 + (2+2) ... = 12
VIEW_UP           equ 7           ; index of the square above you
VIEW_RIGHT        equ 13          ; index of the square to your right
VIEW_DOWN         equ 17          ; index of the square below you
VIEW_LEFT         equ 11          ; index of the square to your left

; ---- Neighbour cell types in VIEW_CELLS
CELL_EMPTY        equ 0           ; nothing there
CELL_FRIEND       equ 1           ; a cell of your colony
CELL_ENEMY        equ 2           ; a cell of another colony
CELL_WALL         equ 3           ; outside the arena

; ---- Directions
DIR_UP            equ 0           ; y - 1
DIR_RIGHT         equ 1           ; x + 1
DIR_DOWN          equ 2           ; y + 1
DIR_LEFT          equ 3           ; x - 1

; ---- Actions, returned in al
ACT_NOP           equ 0x00        ; do nothing
ACT_REST          equ 0x01        ; gain REST_GAIN energy
ACT_MOVE          equ 0x10        ; ACT_MOVE + direction
ACT_SPLIT         equ 0x20        ; ACT_SPLIT + direction: spawn a child there
ACT_EAT           equ 0x30        ; ACT_EAT + direction: take energy from that cell
ACT_FEED          equ 0x40        ; ACT_FEED + direction: give some of your energy to that cell
ACT_DIR_MASK      equ 0x03        ; low two bits of a MOVE/SPLIT/EAT/FEED are the direction

; ---- Persistent cell memory, pointer in rdx
MEM_SIZE          equ 64          ; bytes that survive between calls and are copied to children

; ---- Limits
INSN_BUDGET       equ 1000        ; instructions per call; exceeding it is a fault (no action this tick)

; ---- Ruleset v9
RULESET_VERSION   equ 9           ; rules version these constants belong to
ENERGY_START      equ 10          ; starting energy of each colony's first cell
ENERGY_MAX        equ 50          ; energy is clamped to this
REST_GAIN         equ 1           ; energy gained by ACT_REST
SPLIT_MIN         equ 5           ; you need at least this much energy to split; it is then halved with the child
EAT_TAKE          equ 2           ; at most this much energy ACT_EAT takes from the target
FEED_AMOUNT       equ 2           ; energy an ACT_FEED hands to the target (less if you have less)
MAX_COLONIES      equ 4           ; one per corner